{
    "name": "phoenix_kmeans",
    "description": "Phoenix MapReduce K-Means benchmark - serial, pthreads, and MapReduce variants",
    "source_dir": ".",
    "output_dir": "dfg",
    "default_variant": "serial",
    "lto": false,
    "multithread": false,
    "simple_access": false,
    "pre_compile": null,
    "input_files": {},
    "output_files": {},
    "trace": {
        "runtime_seconds": 30,
        "flush_threshold": null,
        "sample_rate": 1
    },
    "variants": {
        "serial": {
            "sources": [
                "kmeans-seq.c"
            ],
            "opt_level": "O1",
            "compile_flags": [
                "-D_LINUX_",
                "-g",
                "-no-pie",
                "-fno-pic"
            ],
            "link_flags": [
                "-lm"
            ],
            "run_args": ["-p", "200000", "-c", "200", "-d", "5", "-s", "2000"],
            "multithread": false,
            "pre_compile": null
        },
        "pthreads": {
            "sources": [
                "kmeans-pthread.c"
            ],
            "opt_level": "O1",
            "compile_flags": [
                "-D_LINUX_",
                "-g"
            ],
            "link_flags": [
                "-lm",
                "-lpthread"
            ],
            "run_args": ["-p", "200000", "-c", "200", "-d", "5", "-s", "2000"],
            "multithread": true,
            "pre_compile": null
        },
        "mapreduce": {
            "sources": [
                "kmeans.c",
                "MapReduceScheduler.c"
            ],
            "opt_level": "O1",
            "compile_flags": [
                "-D_LINUX_",
                "-g",
                "-no-pie",
                "-fno-pic"
            ],
            "link_flags": [
                "-lm",
                "-lpthread"
            ],
            "run_args": ["-p", "200000", "-c", "200", "-d", "5", "-s", "2000"],
            "multithread": true,
            "pre_compile": null,
            "_lto": true
        }
    }
}